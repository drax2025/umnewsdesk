# ─────────────────────────────────────────────────────────────
# Supabase — get these from your Supabase project dashboard:
#   Project Settings → API
# ─────────────────────────────────────────────────────────────

# Public (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only (NEVER expose in browser code or commit)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Discovery ingestion (n8n / external runners)
# Shared bearer token. Set to a long random string and configure
# the same value as a credential in n8n. Every request to
# /api/ingest/* must send:
#   Authorization: Bearer $INGEST_TOKEN
# ─────────────────────────────────────────────────────────────
INGEST_TOKEN=replace-with-a-long-random-string

# Newsroom V1 handoff — where a selected candidate is sent
NEWSROOM_BASE_URL=https://newsroom.unionmediainc.com
NEWSROOM_INGEST_TOKEN=

# ─────────────────────────────────────────────────────────────
# PR mailbox (Zoho IMAP) — read by /api/cron/poll-mailbox
# Replaces the retired Postmark inbound webhook. Reading the mailbox
# directly gets the agency's original message, so the sender, date and
# Message-ID are real rather than reconstructed from a forwarded wrapper.
# Without IMAP_HOST / IMAP_USER / IMAP_PASSWORD the poller returns 503.
# ─────────────────────────────────────────────────────────────
IMAP_HOST=imap.zoho.eu
IMAP_PORT=993
IMAP_USER=press@yourdomain
IMAP_PASSWORD=an-app-specific-password-not-the-account-password

# Folders. The watched folder IS the queue: a message is moved out once
# stored, so what remains is what still needs attention and a re-run
# cannot double-process. Create these in Zoho before first run.
IMAP_FOLDER=PR/To Process
IMAP_FOLDER_DONE=PR/Ingested
IMAP_FOLDER_FAILED=PR/Failed

# ─────────────────────────────────────────────────────────────
# Cron auth. Vercel sends `Authorization: Bearer $CRON_SECRET`; the same
# value is accepted as ?token= for manual runs.
# ─────────────────────────────────────────────────────────────
CRON_SECRET=replace-with-a-long-random-string
