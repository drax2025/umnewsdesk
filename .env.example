# ─────────────────────────────────────────────────────────────
# Supabase — get these from your Supabase project dashboard:
#   Project Settings → API
# ─────────────────────────────────────────────────────────────

# Public (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only (NEVER expose in browser code or commit)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Discovery ingestion (n8n / external runners)
# Shared bearer token. Set to a long random string and configure
# the same value as a credential in n8n. Every request to
# /api/ingest/* must send:
#   Authorization: Bearer $INGEST_TOKEN
# ─────────────────────────────────────────────────────────────
INGEST_TOKEN=replace-with-a-long-random-string
