  "id": "XTuAXu1_WlOgnTzn_Uhye",
  "name": "UM Newsroom — PR mailbox poll (10 min)",
  "description": null,
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "0a693dac-c013-48b9-84ae-c99814da9d11",
      "name": "Every 30 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -720,
        80
      ]
    },
    {
      "parameters": {
        "url": "=https://desk.unionmedia.news/api/cron/poll-mailbox",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {
          "timeout": 300000
        }
      },
      "id": "724e0d8a-befd-4262-ac6c-9c62cc9d456a",
      "name": "Poll PR mailbox",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -480,
        80
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "sweLPqaBSfJKUGqw",
          "name": "UK Newsroom - CRON SECRET"
        }
      },
      "notes": "Needs a header-auth credential sending Authorization: Bearer <CRON_SECRET>. NOT the INGEST_TOKEN credential used by the sweep — different secret."
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.failed }}",
              "operation": "larger"
            }
          ]
        }
      },
      "id": "24ceeb73-ef40-49ad-af93-10bbab900b65",
      "name": "Any failures?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        -240,
        80
      ]
    },
    {
      "parameters": {
        "url": "=https://desk.unionmedia.news/api/ingest/alert",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"severity\": \"p2\",\n  \"issue_type\": \"parse_failure\",\n  \"description\": \"PR mailbox poll: {{ $json.failed }} message(s) failed — {{ $json.errors.join('; ') }}\"\n}",
        "options": {}
      },
      "id": "7498a5be-f4c2-4588-a6a6-9fd74e4a1b36",
      "name": "File OPS-RR alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "xZtFcbaF4LXlLbvX",
          "name": "Runware N8nLocal"
        }
      },
      "notes": "Uses the INGEST_TOKEN credential, not CRON_SECRET."
    }
  ],
  "connections": {
    "Every 30 minutes": {
      "main": [
        [
          {
            "node": "Poll PR mailbox",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll PR mailbox": {
      "main": [
        [
          {
            "node": "Any failures?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any failures?": {
      "main": [
        [
          {
            "node": "File OPS-RR alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
