{
  "name": "UM Newsroom — RSS sweep (am + pm)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8,16 * * *"
            }
          ]
        }
      },
      "id": "a9b1c2d3-0002-4000-8000-000000000001",
      "name": "Schedule 08:00 + 16:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const hour = new Date().getUTCHours();\nconst slot = hour < 12 ? 'am' : 'pm';\nreturn [{ json: { slot, trigger: 'scheduled' } }];"
      },
      "id": "a9b1c2d3-0002-4000-8000-000000000002",
      "name": "Derive slot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.UM_BASE_URL }}/api/ingest/sweep",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"slot\": \"{{ $json.slot }}\",\n  \"trigger\": \"{{ $json.trigger }}\"\n}",
        "options": {}
      },
      "id": "a9b1c2d3-0002-4000-8000-000000000003",
      "name": "Open sweep",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "UM Newsroom — INGEST_TOKEN"
        }
      }
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "a9b1c2d3-0002-4000-8000-000000000005",
      "name": "Loop sources",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1240,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.feed_url }}",
        "options": {
          "ignoreSSL": false
        }
      },
      "id": "a9b1c2d3-0002-4000-8000-000000000006",
      "name": "Fetch RSS",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        1460,
        220
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Map each RSS item into the IngestItem envelope. Trim long bodies;\n// the route caps them too but it's cheaper to do it here.\nconst source = $('Loop sources').item.json;\nconst now = new Date().toISOString();\nconst items = $input.all().slice(0, 50); // soft cap per source per sweep\nreturn items.map((it) => {\n  const r = it.json;\n  const headline = (r.title || '').toString().trim();\n  if (!headline) return null;\n  return {\n    json: {\n      sweep_id: source.sweep_id,\n      source_code: source.code,\n      kind: 'rss',\n      fetched_at: now,\n      item: {\n        headline,\n        external_id: r.guid || r.id || r.link || null,\n        primary_url: r.link || null,\n        published_at: r.isoDate || r.pubDate || null,\n        summary: r.contentSnippet || r.summary || null,\n        body_text: r['content:encoded'] || r.content || null,\n        author: r.creator || r['dc:creator'] || r.author || null,\n        tags: Array.isArray(r.categories) ? r.categories.slice(0, 16) : [],\n        raw: r\n      }\n    }\n  };\n}).filter(Boolean);"
      },
      "id": "a9b1c2d3-0002-4000-8000-000000000007",
      "name": "Map RSS → items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.UM_BASE_URL }}/api/ingest/item",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 250
            }
          }
        }
      },
      "id": "a9b1c2d3-0002-4000-8000-000000000008",
      "name": "Post item",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1900,
        220
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "UM Newsroom — INGEST_TOKEN"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Roll the per-source outcome up for /complete. The route ignores\n// candidate_count — it counts authoritative rows — but parse_issue_count\n// and outcome are honoured.\nconst source = $('Loop sources').item.json;\nreturn [{\n  json: {\n    source_code: source.code,\n    outcome: 'reached_items',\n    http_status: 200,\n    parse_issue_count: 0\n  }\n}];"
      },
      "id": "a9b1c2d3-0002-4000-8000-000000000009",
      "name": "Record success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2120,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "// RSS fetch failed — record outcome and raise a P2 alert.\nconst source = $('Loop sources').item.json;\nreturn [{\n  json: {\n    source_code: source.code,\n    outcome: 'parse_failure',\n    http_status: 0,\n    parse_issue_count: 1,\n    _alert: {\n      source_code: source.code,\n      sweep_id: source.sweep_id,\n      severity: 'p2',\n      issue_type: 'unreachable',\n      description: 'RSS fetch failed for ' + source.code + ' (' + source.feed_url + ')'\n    }\n  }\n}];"
      },
      "id": "a9b1c2d3-0002-4000-8000-000000000010",
      "name": "Record failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.UM_BASE_URL }}/api/ingest/alert",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json._alert) }}",
        "options": {}
      },
      "id": "a9b1c2d3-0002-4000-8000-000000000011",
      "name": "File alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1900,
        400
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "UM Newsroom — INGEST_TOKEN"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.UM_BASE_URL }}/api/ingest/sweep/{{ $('Open sweep').first().json.sweep_id }}/complete",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ site_results: $input.all().map(i => i.json) }) }}",
        "options": {}
      },
      "id": "a9b1c2d3-0002-4000-8000-000000000012",
      "name": "Complete sweep",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2360,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "UM Newsroom — INGEST_TOKEN"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.UM_BASE_URL }}/api/ingest/sources?method=rss",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {}
      },
      "id": "fetch-source-list",
      "name": "Fetch source list",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ],
      "notes": "Reads discovery_sources from the app so the registry is authoritative. Add/remove sources in /system/discovery-config, not here.",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "UM Newsroom — INGEST_TOKEN"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Source list now comes from the app's registry (discovery_sources) via\n// /api/ingest/sources — do NOT hardcode sources here. Manage them in\n// /system/discovery-config; paused sources are filtered out server-side.\nconst sweep = $('Open sweep').first().json;\nconst payload = $input.first().json;\nconst sources = Array.isArray(payload.sources) ? payload.sources : [];\n\nif (sources.length === 0) {\n  // Nothing to sweep. Returning [] would silently end the run, so surface it.\n  throw new Error('Source registry returned 0 active rss sources — check /system/discovery-config');\n}\n\nreturn sources.map((s) => ({\n  json: {\n    code: s.code,\n    feed_url: s.feed_url,\n    name: s.name,\n    layer: s.layer,\n    signal_only_eligible: s.signal_only_eligible,\n    sweep_id: sweep.sweep_id,\n    sweep_code: sweep.sweep_code,\n  },\n}));"
      },
      "id": "build-source-queue",
      "name": "Build source queue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1010,
        300
      ],
      "notes": "Fans the registry response out to one item per source."
    }
  ],
  "connections": {
    "Schedule 08:00 + 16:00": {
      "main": [
        [
          {
            "node": "Derive slot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Derive slot": {
      "main": [
        [
          {
            "node": "Open sweep",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Open sweep": {
      "main": [
        [
          {
            "node": "Fetch source list",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop sources": {
      "main": [
        [
          {
            "node": "Complete sweep",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Fetch RSS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch RSS": {
      "main": [
        [
          {
            "node": "Map RSS → items",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Record failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Map RSS → items": {
      "main": [
        [
          {
            "node": "Post item",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post item": {
      "main": [
        [
          {
            "node": "Record success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record success": {
      "main": [
        [
          {
            "node": "Loop sources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record failure": {
      "main": [
        [
          {
            "node": "File alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "File alert": {
      "main": [
        [
          {
            "node": "Loop sources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch source list": {
      "main": [
        [
          {
            "node": "Build source queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build source queue": {
      "main": [
        [
          {
            "node": "Loop sources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "um-newsroom"
    },
    {
      "name": "ingest"
    },
    {
      "name": "rss"
    }
  ]
}