{
  "name": "UM Newsroom — PR mailbox poll (30 min)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "minutes", "minutesInterval": 30 } ] }
      },
      "id": "schedule-30min",
      "name": "Every 30 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [ 260, 300 ]
    },
    {
      "parameters": {
        "url": "={{ $env.UM_BASE_URL }}/api/cron/poll-mailbox",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": { "timeout": 300000 }
      },
      "id": "poll-mailbox",
      "name": "Poll PR mailbox",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 500, 300 ],
      "notes": "Needs a header-auth credential sending Authorization: Bearer <CRON_SECRET>. NOT the INGEST_TOKEN credential used by the sweep — different secret.",
      "credentials": { "httpHeaderAuth": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "UM Newsroom — CRON_SECRET" } }
    },
    {
      "parameters": {
        "conditions": {
          "number": [ { "value1": "={{ $json.failed }}", "operation": "larger", "value2": 0 } ]
        }
      },
      "id": "any-failures",
      "name": "Any failures?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [ 740, 300 ]
    },
    {
      "parameters": {
        "url": "={{ $env.UM_BASE_URL }}/api/ingest/alert",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"severity\": \"p2\",\n  \"issue_type\": \"parse_failure\",\n  \"description\": \"PR mailbox poll: {{ $json.failed }} message(s) failed — {{ $json.errors.join('; ') }}\"\n}",
        "options": {}
      },
      "id": "file-alert",
      "name": "File OPS-RR alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 980, 220 ],
      "notes": "Uses the INGEST_TOKEN credential, not CRON_SECRET.",
      "credentials": { "httpHeaderAuth": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "UM Newsroom — INGEST_TOKEN" } }
    }
  ],
  "connections": {
    "Every 30 minutes": { "main": [ [ { "node": "Poll PR mailbox", "type": "main", "index": 0 } ] ] },
    "Poll PR mailbox": { "main": [ [ { "node": "Any failures?", "type": "main", "index": 0 } ] ] },
    "Any failures?": { "main": [ [ { "node": "File OPS-RR alert", "type": "main", "index": 0 } ], [] ] }
  },
  "settings": { "executionOrder": "v1" }
}
